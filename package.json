{
  "name": "dsh-cot-export",
  "version": "1.0.0",
  "type": "module",
  "description": "Export a DSH session's complete model chain-of-thought to Markdown, JSON, JSONL or text, and hand the artifact to any other session or agent for review.",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test test/cot.test.mjs",
    "test:watch": "node --test --watch test/cot.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "chain-of-thought",
    "reasoning",
    "export",
    "review",
    "agent-observability"
  ],
  "author": {
    "name": "aliarrrrr",
    "url": "https://github.com/Aliarrrrr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliarrrrr/dsh-cot-export.git"
  },
  "homepage": "https://github.com/Aliarrrrr/dsh-cot-export#readme",
  "bugs": {
    "url": "https://github.com/Aliarrrrr/dsh-cot-export/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
